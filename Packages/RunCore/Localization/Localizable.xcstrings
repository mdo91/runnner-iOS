    "OnboardingView.WelcomePage.title.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand every run."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstehe jeden Lauf."
          }
        }
      }
    },
    "OnboardingView.WelcomePage.body.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your recorded runs into a clear picture of your effort, consistency, and progress."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke, was deine aufgezeichneten Läufe über Belastung, Regelmäßigkeit und Fortschritt zeigen."
          }
        }
      }
    },
    "OnboardingView.HealthPage.title.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your runs. Together."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Läufe. An einem Ort."
          }
        }
      }
    },
    "OnboardingView.HealthPage.body.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring in runs from Apple Health, including Apple Watch workouts. No account is needed for your measured statistics."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere Läufe aus Apple Health – auch Trainings deiner Apple Watch. Für deine gemessenen Werte brauchst du kein Konto."
          }
        }
      }
    },
    "OnboardingView.InsightsPage.title.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See beyond the finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh mehr als die Zielzeit."
          }
        }
      }
    },
    "OnboardingView.InsightsPage.body.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore pace, heart rate, splits, and recorded routes. See what was measured, and where data is missing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkunde Tempo, Herzfrequenz, Zwischenzeiten und aufgezeichnete Routen. Erkenne, was gemessen wurde und wo Daten fehlen."
          }
        }
      }
    },
    "OnboardingView.ProgressPage.title.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small steps. Real progress."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Schritte. Echter Fortschritt."
          }
        }
      }
    },
    "OnboardingView.ProgressPage.body.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a routine with goals and trends. Optional AI explains your recorded runs after you sign in and give permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickle mit Zielen und Trends deine Laufroutine. Auf Wunsch erklärt KI deine aufgezeichneten Läufe – erst nach Anmeldung und Einwilligung."
          }
        }
      }
    },
    "OnboardingView.SharePage.body.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your statistics and route to a photo or video. Create and export on your iPhone, then choose where to share."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänze Fotos oder Videos mit deinen Laufdaten und deiner Route. Bearbeite und exportiere auf deinem iPhone und entscheide selbst, wo du sie teilst."
          }
        }
      }
    },
    "OnboardingView.PrivacyPage.title.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data. Your choice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten. Deine Wahl."
          }
        }
      }
    },
    "OnboardingView.PrivacyPage.body.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Apple Health when you are ready. AI analysis, cloud history, and GPS sharing are separate choices in Settings, and start switched off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Apple Health, wenn du bereit bist. KI-Analyse, Cloud-Verlauf und GPS-Freigabe sind separate Optionen in den Einstellungen und anfangs ausgeschaltet."
          }
        }
      }
    },

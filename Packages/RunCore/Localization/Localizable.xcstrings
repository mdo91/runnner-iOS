    "TrendsScreen.Format.comparedWithPriorRunsOfSimilarDistanceSetting.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compared with %1$@ prior runs of similar distance, setting, and heart rate. Weather, terrain, and effort still influence this comparison."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verglichen mit %1$@ früheren Läufen mit ähnlicher Distanz, Umgebung und Herzfrequenz. Wetter, Gelände und Belastung beeinflussen diesen Vergleich weiterhin."
          }
        }
      }
    },
    "TrendsScreen.Format.atLeastFiveComparableRunsWithSufficientHeart.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least five comparable runs with sufficient heart-rate coverage are needed before showing a pace trend. You have %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Tempotrend werden mindestens fünf vergleichbare Läufe mit ausreichenden Herzfrequenzdaten benötigt. Du hast %1$@."
          }
        }
      }
    },
    "RunDetailScreen.Format.importedFromMissingMeasurementsAppearAs.text": {

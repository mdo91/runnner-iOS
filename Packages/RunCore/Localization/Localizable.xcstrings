    "SettingsScreen.Copy.appleDoesNotRevealWhichReadPermissionsYouGranted.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple does not reveal which read permissions you granted. Empty results can mean no data, disabled access, or a pending Watch sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple zeigt nicht an, welche Leserechte du erteilt hast. Leere Ergebnisse können fehlende Daten, deaktivierten Zugriff oder eine ausstehende Watch-Synchronisierung bedeuten."
          }
        }
      }
    },

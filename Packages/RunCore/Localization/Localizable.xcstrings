    "HistorySyncManager.Copy.historyAndRoutesSyncIsEnabled.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History and routes sync is enabled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf und Routen werden synchronisiert."
          }
        }
      }
    },
    "HistorySyncManager.Copy.historySyncIsEnabledUploadedGPSCoordinatesHaveBeen.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History sync is enabled. Uploaded GPS coordinates have been removed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf wird synchronisiert. Hochgeladene GPS-Koordinaten wurden entfernt."
          }
        }
      }
    },
    "HistorySyncManager.Copy.historySyncIsOffUploadedGPSCoordinatesHaveBeen.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History sync is off. Uploaded GPS coordinates have been removed; numerical history remains until you delete it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verlaufssynchronisierung ist aus. Hochgeladene GPS-Koordinaten wurden entfernt; numerische Verlaufsdaten bleiben, bis du sie löschst."
          }
        }
      }
    },
    "HistorySyncManager.Copy.sharingIsPausedOnThisPhoneConnectToThe.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing is paused on this phone. Connect to the internet to finish the privacy change and remove uploaded GPS coordinates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe ist auf diesem iPhone pausiert. Verbinde dich mit dem Internet, um die Datenschutzänderung abzuschließen und hochgeladene GPS-Koordinaten zu entfernen."
          }
        }
      }
    },
    "HistorySyncManager.Copy.consentCouldNotBeSavedPleaseRetryWhenConnected.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consent could not be saved. Please retry when connected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einwilligung konnte nicht gespeichert werden. Versuche es erneut, sobald du verbunden bist."
          }
        }
      }
    },
    "HistorySyncManager.Copy.historySyncIsPausedSavedDashboardHistoryRemainsAvailable.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History sync is paused. Saved dashboard history remains available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verlaufssynchronisierung ist pausiert. Gespeicherte Dashboard-Daten bleiben verfügbar."
          }
        }
      }
    },
    "HistorySyncManager.Copy.historySyncPausedSavedRunsRemainAvailableReconnectAnd.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History sync paused. Saved runs remain available. Reconnect and tap Sync now to retry. If consent changed on another device, this phone will follow it on retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verlaufssynchronisierung ist pausiert. Gespeicherte Läufe bleiben verfügbar. Verbinde dich erneut und tippe auf „Jetzt synchronisieren“. Wurde die Einwilligung auf einem anderen Gerät geändert, übernimmt dieses iPhone sie beim nächsten Versuch."
          }
        }
      }
    },
    "HistorySyncManager.Copy.yourUploadedHistoryAndRoutesHaveBeenDeletedLocal.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your uploaded history and routes have been deleted. Local Health workouts remain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein hochgeladener Verlauf und deine Routen wurden gelöscht. Lokale Health-Trainings bleiben erhalten."
          }
        }
      }
    },
    "HistorySyncManager.Copy.cloudHistoryCouldNotBeDeletedPleaseReconnectAnd.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud history could not be deleted. Please reconnect and retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cloud-Verlauf konnte nicht gelöscht werden. Stelle die Verbindung wieder her und versuche es erneut."
          }
        }
      }
    },
    "RunPhotoIO.Copy.thisPhotoCouldnTBeLoadedTryAgainOr.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo couldn’t be loaded. Try again, or choose another image. If it’s in iCloud, check your connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto konnte nicht geladen werden. Versuche es erneut oder wähle ein anderes Bild. Liegt es in iCloud, prüfe deine Verbindung."
          }
        }
      }
    },
    "RunPhotoIO.Copy.theImageCouldnTBeExportedYourEditsAre.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image couldn’t be exported. Your edits are still here. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte nicht exportiert werden. Deine Änderungen sind noch da. Versuche es erneut."
          }
        }
      }
    },
    "RunPhotoIO.Copy.runnerNeedsAddOnlyPhotosAccessToSaveHere.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runner needs add-only Photos access to save here. You can use Share instead. Changing access in Settings may restart Runner and discard this edit, so share a copy first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Speichern benötigt Runner die Berechtigung, Fotos hinzuzufügen. Alternativ kannst du „Teilen“ verwenden. Eine Änderung der Berechtigung in den Einstellungen kann Runner neu starten und diese Bearbeitung verwerfen. Teile deshalb zuerst eine Kopie."
          }
        }
      }
    },
    "RunPhotoIO.Copy.thisAppCouldnTFinishSharingTryAgainOr.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app couldn’t finish sharing. Try again or choose another destination."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App konnte das Teilen nicht abschließen. Versuche es erneut oder wähle ein anderes Ziel."
          }
        }
      }
    },
    "RunVideoIO.Copy.thisVideoCouldnTBeLoadedTryAnotherClip.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video couldn’t be loaded. Try another clip. If it’s in iCloud, check your connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video konnte nicht geladen werden. Wähle einen anderen Clip. Liegt es in iCloud, prüfe deine Verbindung."
          }
        }
      }
    },
    "RunVideoIO.Copy.theVideoCouldnTBeExportedYourEditsAre.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video couldn’t be exported. Your edits are still here. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video konnte nicht exportiert werden. Deine Änderungen sind noch da. Versuche es erneut."
          }
        }
      }
    },
    "AccountManager.Copy.couldNotPrepareSecureSignIn.text": {
      "extractionState": "manual",

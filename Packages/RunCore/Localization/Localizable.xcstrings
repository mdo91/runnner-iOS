    "AnalysisManager.Copy.thisRunIsAlreadyBeingAnalyzedTryAgainShortly.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run is already being analyzed. Try again shortly."

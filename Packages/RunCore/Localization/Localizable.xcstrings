    "AccountManager.Copy.yourCloudAccountSyncedHistoryRoutesAndAnalysisData.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud account, synced history, routes, and analysis data have been deleted. Health data remains on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Cloud-Konto, synchronisierter Verlauf, Routen und Analysedaten wurden gelöscht. Health-Daten bleiben auf diesem Gerät."
          }
        }
      }
    },
    "AccountManager.Copy.accountDeletionCouldNotFinishSignInAgainTo.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deletion could not finish. Sign in again to retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto konnte nicht vollständig gelöscht werden. Melde dich erneut an und versuche es noch einmal."
          }
        }
      }
    },
    "AccountManager.Copy.signInWasNotCompletedYouCanKeepUsing.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in was not completed. You can keep using your measured stats."

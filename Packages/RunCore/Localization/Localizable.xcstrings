    "ContentView.Copy.findingYourLatestRun.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding your latest run"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein letzter Lauf wird gesucht"
          }
        }
      }
    },
    "ContentView.Copy.yourNextChapterStartsHere.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next chapter starts here"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein nächstes Kapitel beginnt hier"
          }
        }
      }
    },
    "ContentView.Copy.noRunningWorkoutsAreAvailableRecordARunOn.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No running workouts are available. Record a run on Apple Watch, or check Runner’s read access in Health. Health may need time to sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Lauftrainings verfügbar. Zeichne einen Lauf mit der Apple Watch auf oder prüfe die Leserechte von Runner in Health. Die Synchronisierung kann etwas dauern."
          }
        }
      }
    },
    "ContentView.Copy.connectAppleHealthToSeeYourLatestRunExplore.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Apple Health to see your latest run, explore your routes, and follow your progress."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Apple Health, um deinen letzten Lauf zu sehen, Routen zu erkunden und deinen Fortschritt zu verfolgen."
          }
        }
      }
    },
    "Common.Copy.connectAppleHealth.text": {
      "extractionState": "manual",
      "localizations": {

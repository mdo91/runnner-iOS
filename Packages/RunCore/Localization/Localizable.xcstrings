    "Common.Copy.allowAIAnalysis.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow AI analysis"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Analyse erlauben"
          }
        }
      }
    },
    "SettingsScreen.Copy.withYourPermissionRunnerSendsNumericalRunSummariesSplits.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your permission, Runner sends numerical run summaries, splits, data-quality flags, and a compact historical baseline to Runner’s backend and Google Gemini to provide fitness coaching. Precise GPS routes, names, email addresses, and raw HealthKit samples are excluded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deiner Erlaubnis sendet Runner numerische Laufzusammenfassungen, Zwischenzeiten, Hinweise zur Datenqualität und eine kompakte historische Vergleichsbasis an das Runner-Backend und Google Gemini für Fitnesscoaching. Genaue GPS-Routen, Namen, E-Mail-Adressen und rohe HealthKit-Messwerte sind ausgeschlossen."
          }
        }
      }
    },
    "SettingsScreen.Copy.theLatestRunIsAnalyzedAutomaticallyThenNewRuns.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest run is analyzed automatically, then new runs as they arrive. Older runs are analyzed only when requested. Cloud reports expire after 24 hours; reports saved on this device remain available. You can turn sharing off at any time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Lauf und danach neu eingehende Läufe werden automatisch analysiert. Ältere Läufe nur auf Anfrage. Cloud-Berichte laufen nach 24 Stunden ab; auf diesem Gerät gespeicherte Berichte bleiben verfügbar. Du kannst die Freigabe jederzeit deaktivieren."
          }
        }
      }
    },
    "SettingsScreen.Copy.upTo3CompletedRunAnalysesPerDayYour.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 3 completed-run analyses per day. Your measured statistics work without AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 3 Analysen abgeschlossener Läufe pro Tag. Deine gemessenen Werte funktionieren ohne KI."
          }
        }
      }
    },
    "SettingsScreen.Copy.aIFeedbackIsAdultFitnessCoachingNotMedicalDiagnosis.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI feedback is adult fitness coaching, not medical diagnosis. Consent version: October 3, 2026."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Feedback ist Fitnesscoaching für Erwachsene, keine medizinische Diagnose. Einwilligungsversion: 3. Oktober 2026."
          }
        }
      }
    },
    "Common.Copy.cloudHistory.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud history"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Verlauf"
          }
        }
      }
    },
    "Common.Copy.syncRunningHistory.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync running history"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufverlauf synchronisieren"
          }
        }
      }
    },
    "SettingsScreen.Copy.withYourConsentRunnerStoresYourRunningHistoryMeasured.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your consent, Runner stores your running history, measured stats, splits, chart summaries, dated VO₂ max and recovery measurements, and saved AI reports in your private backend account. Synced history stays until you delete it; it does not expire after 24 hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deiner Einwilligung speichert Runner deinen Laufverlauf, Messwerte, Zwischenzeiten, Diagrammzusammenfassungen, datierte VO₂max- und Erholungsmessungen sowie gespeicherte KI-Berichte in deinem privaten Backend-Konto. Der synchronisierte Verlauf bleibt, bis du ihn löschst; er läuft nicht nach 24 Stunden ab."
          }
        }
      }
    },
    "SettingsScreen.Copy.alsoSyncPreciseGPSRoutes.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also sync precise GPS routes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch genaue GPS-Routen synchronisieren"
          }
        }
      }
    },
    "SettingsScreen.Copy.gPSSharingIsASeparateChoiceRoutesRevealWhere.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS sharing is a separate choice. Routes reveal where you run. They are stored in your account for dashboard maps and are never sent to Gemini. Turning this off deletes uploaded coordinates across your account. If offline, removal finishes when this phone reconnects."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GPS-Freigabe ist eine separate Entscheidung. Routen zeigen, wo du läufst. Sie werden für Dashboard-Karten in deinem Konto gespeichert und nie an Gemini gesendet. Beim Deaktivieren werden hochgeladene Koordinaten im gesamten Konto gelöscht. Ohne Internet wird die Löschung abgeschlossen, sobald dieses iPhone wieder verbunden ist."
          }
        }
      }
    },
    "Common.Copy.syncNow.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync now"

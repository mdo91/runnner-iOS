            "state": "translated",
            "value": "Dein Cloud-Konto löschen"
          }
        }
      }
    },
    "SettingsScreen.Copy.yourSyncedHistoryGPSRoutesCloudAnalysesDashboardSessions.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your synced history, GPS routes, cloud analyses, dashboard sessions, and account access will be removed. Your local workouts and Apple Health records stay on your device. Confirm with Apple to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein synchronisierter Verlauf, GPS-Routen, Cloud-Analysen, Dashboard-Sitzungen und Kontozugriff werden entfernt. Lokale Trainings und Apple-Health-Daten bleiben auf deinem Gerät. Bestätige mit Apple, um fortzufahren."
          }
        }
      }
    },
